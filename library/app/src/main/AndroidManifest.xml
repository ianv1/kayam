<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="asia.chumbaka.kayam.library.bm"
    android:installLocation="auto">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_LOGS" />

    <!-- Android 11+ package-visibility allow-list.
         Without these, PackageManager#getPackageInfo for either bookviewer
         throws NameNotFoundException, so the per-language picker in
         MainActivity#onClick can't probe what's installed and falls
         through to "Error". -->
    <queries>
        <package android:name="asia.chumbaka.kayam.bookviewer" />
        <package android:name="asia.chumbaka.kayam.bookviewer.bm" />
    </queries>

    <application
        android:name=".LibraryApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:largeHeap="true">
        <activity android:name=".SelectActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <!--<category android:name="android.intent.category.LAUNCHER" />-->
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity"
            android:screenOrientation="sensorLandscape">
        </activity>
        <!--<activity android:name=".BookDetailActivity"-->
            <!--android:screenOrientation="landscape">-->
        <!--</activity>-->
        <activity
            android:name=".VideoPlayerActivity"
            android:screenOrientation="sensorLandscape">
        </activity>
    </application>

</manifest>
